<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear: don't inherit machine-level feeds, so every machine restores the same set. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Microsoft.DotNet.GenAPI.Tool is never published to nuget.org; it only
         ships to the .NET SDK transport feed. -->
    <add key="dotnet10-transport" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet10-transport/nuget/v3/index.json" />
    <!-- BepInEx.Core is a runtime dependency of spt-prepatch and is only
         published on the BepInEx feed, never on nuget.org. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
  <!-- The transport feed may serve exactly one package; everything else,
       including the baseline closure, comes from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="dotnet10-transport">
      <package pattern="Microsoft.DotNet.GenAPI.Tool" />
    </packageSource>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
