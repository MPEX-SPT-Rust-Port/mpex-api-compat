<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SPTarkov.Common" Version="[4.1.2]" />
    <PackageReference Include="SPTarkov.DI" Version="[4.1.2]" />
    <PackageReference Include="SPTarkov.Reflection" Version="[4.1.2]" />
    <!-- The Assets package ships SPT_Data content whose .png/.json files are marked
         buildAction=Compile; excluding contentFiles keeps the reflection-only build sane.
         Same exclusion as tools/SrvBaselineClosure/SrvBaselineClosure.csproj. -->
    <PackageReference Include="SPTarkov.Server.Assets" Version="[4.1.2]" ExcludeAssets="contentFiles" />
    <PackageReference Include="SPTarkov.Server.Core" Version="[4.1.2]" />
    <PackageReference Include="SPTarkov.Server.Web" Version="[4.1.2]" />
  </ItemGroup>
</Project>
